<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 长条底板：对齐 MIUI 桌面卡片——白色半透明 + 大圆角 + 极淡描边 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="270"
        android:startColor="#FAFFFFFF"
        android:centerColor="#F5FBFCFF"
        android:endColor="#F0F5F9FF" />
    <stroke
        android:width="1dp"
        android:color="#14000000" />
</shape>
