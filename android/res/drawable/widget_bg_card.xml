<?xml version="1.0" encoding="utf-8"?>
<!-- 卡片底板：对齐 MIUI 桌面白色卡片——半透明白 + 24dp 大圆角 + 极淡描边 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="315"
        android:startColor="#FBFFFFFF"
        android:centerColor="#F6FBFDFF"
        android:endColor="#F0F4F8FF" />
    <stroke
        android:width="1dp"
        android:color="#16000000" />
</shape>
