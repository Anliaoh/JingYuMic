<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 长条（浅色 · 对齐 MIUI 桌面卡片风格）：封面 + 歌名/歌手/歌词 + 上一首/播放/下一首 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="11dp"
    android:paddingRight="7dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg_bar">

    <ImageView
        android:id="@+id/wCover"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="11dp"
        android:layout_marginRight="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#16202F"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/wArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/w_idle_sub"
            android:textColor="#6B7688"
            android:textSize="10.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/wLrc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text=""
            android:textColor="#8B96A8"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:includeFontPadding="false" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/wPrev"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="6dp"
        android:background="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_w_prev_d"
        android:contentDescription="@string/w_prev" />

    <ImageButton
        android:id="@+id/wPlay"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="2dp"
        android:background="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_w_play"
        android:contentDescription="@string/w_play" />

    <ImageButton
        android:id="@+id/wNext"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="6dp"
        android:background="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_w_next_d"
        android:contentDescription="@string/w_next" />
</LinearLayout>
